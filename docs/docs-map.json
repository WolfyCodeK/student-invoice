{
  "$comment": "Which source files each doc describes. See docs/documentation.md. Every file matching 'sources' (minus 'ignore') must be covered by at least one doc, or be listed in 'pendingCoverage' (which must be empty for a release).",
  "sources": [
    "app/src/**",
    "app/src-tauri/src/**",
    "app/src-tauri/build.rs",
    "app/src-tauri/Cargo.toml",
    "app/src-tauri/tauri*.json",
    "app/src-tauri/capabilities/**",
    "app/*.{ts,js,json,html}",
    "app/.npmrc",
    "scripts/**",
    ".github/**",
    ".githooks/**",
    ".claude/settings.json",
    ".mcp.json"
  ],
  "ignore": [
    "app/src/assets/**",
    "app/src/vite-env.d.ts"
  ],
  "records": [
    "docs/audits/**",
    "docs/proposals/**",
    "docs/decisions/**"
  ],
  "docs": {
    "docs/README.md": {
      "covers": []
    },
    "docs/architecture.md": {
      "covers": [
        "app/src-tauri/src/lib.rs",
        "app/src-tauri/src/main.rs",
        "app/src-tauri/build.rs",
        "app/src-tauri/Cargo.toml",
        "app/src-tauri/tauri*.json",
        "app/src-tauri/capabilities/**",
        "app/src/stores/**",
        "app/src/main.tsx",
        "app/src/types/**",
        "app/vite.config.ts",
        "app/src-tauri/src/commands.rs",
        "app/src-tauri/src/error.rs",
        "app/src-tauri/src/updates.rs",
        "app/src/lib/backend.ts"
      ]
    },
    "docs/data-model.md": {
      "covers": [
        "app/src/stores/app-store.ts",
        "app/src/types/**",
        "app/src/lib/schema/**",
        "app/src/lib/appearance.ts"
      ]
    },
    "docs/billing.md": {
      "covers": [
        "app/src/utils/terms.ts",
        "app/src/utils/invoice-generator.ts",
        "app/src/utils/billing.characterization.test.ts",
        "app/src/utils/__snapshots__/**",
        "app/src/utils/untick-lessons.test.ts"
      ]
    },
    "docs/gmail.md": {
      "covers": [
        "app/src-tauri/src/google/**"
      ]
    },
    "docs/ui.md": {
      "covers": [
        "app/src/App.tsx",
        "app/src/components/**",
        "app/src/hooks/**",
        "app/index.html",
        "app/src/features/**",
        "app/src/styles/**",
        "app/src/lib/appearance.ts",
        "app/src/lib/format.ts",
        "app/src/lib/term-display.ts",
        "app/src/lib/term-display.test.ts"
      ]
    },
    "docs/compatibility.md": {
      "covers": [
        "scripts/invariants.config.mjs",
        "scripts/check-invariants.mjs"
      ]
    },
    "docs/security.md": {
      "covers": [
        "app/src-tauri/capabilities/**",
        "scripts/check-secrets.mjs",
        "app/src-tauri/build.rs",
        "app/src-tauri/src/google/loopback.rs",
        "app/src-tauri/src/google/store.rs"
      ]
    },
    "docs/development.md": {
      "covers": [
        "app/package.json",
        "app/eslint.config.js",
        "app/vitest.config.ts",
        "app/tsconfig*.json",
        "app/.npmrc",
        "scripts/lib/**",
        ".githooks/**",
        ".github/**",
        ".claude/settings.json",
        "scripts/tests/**",
        ".mcp.json"
      ]
    },
    "docs/documentation.md": {
      "covers": [
        "scripts/docs/**"
      ]
    },
    "docs/release.md": {
      "covers": [
        "scripts/release/**"
      ]
    },
    "docs/backup.md": {
      "covers": [
        "app/src-tauri/src/backup.rs",
        "app/src/lib/backup.ts",
        "app/src/lib/backup-parse.ts",
        "app/src/lib/backup.test.ts",
        "app/src/lib/schema/**",
        "app/src/features/settings/data-group.tsx"
      ]
    },
    "docs/performance.md": {
      "covers": [
        "scripts/perf/**",
        "app/src-tauri/src/preferences.rs",
        "app/src/features/settings/performance-group.tsx"
      ]
    }
  },
  "pendingCoverage": []
}
