#!/bin/sh
# Fast checks before every commit. Enabled by `pnpm install` in app/
# (git config core.hooksPath .githooks). See docs/development.md.
set -e
cd "$(git rev-parse --show-toplevel)"

node scripts/check-secrets.mjs --staged
node scripts/check-invariants.mjs
node scripts/docs/generate.mjs --check
node scripts/docs/links.mjs

# Frontend checks only when frontend files are staged.
if git diff --cached --name-only | grep -q '^app/'; then
  (cd app && pnpm -s typecheck && pnpm -s lint)
fi
